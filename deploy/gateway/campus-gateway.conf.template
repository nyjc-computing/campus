# Campus edge gateway — path-dispatching reverse proxy for the campus
# services under one hostname (issue #995). Rendered at container start
# by the nginx image's envsubst runner: only ${VARS} that exist in the
# environment are substituted; nginx runtime variables ($host etc.) and
# $-variables we set below pass through untouched.
#
# Dispatch (paths passed through UNCHANGED — each service's internal
# routes already carry its public prefix, and the test harness runs
# this exact topology):
#   /auth/*  /integrations/*  -> campus.auth   (/auth/v1, public catalog)
#   /api/*                    -> campus.api    (/api/v1)
#   /audit/*                  -> campus.audit  (/audit/v1, web UI, static)
#
# Downstream consumer apps (#1274), each under the namespace it already
# serves on its own deployment; an environment wires one in by setting
# the matching *_HOST/*_PORT vars on the gateway service — where unset,
# the Dockerfile ENV placeholders (.invalid names) keep the config
# valid and those paths 502 harmlessly:
#   /timetable/*              -> nyxchange-timetable-v2 (/timetable/)
#   /apps/*                   -> campus-apphost         (/apps/)
#   /admin/*                  -> campus-admin           (/admin/)
#   /profile/*                -> campus-profile         (/profile/)
#   /classroom/*              -> campus-classroom       (/classroom/)
#
# Root space: the gateway owns it. / reports the Campus landing page
# (static, from the image — #1292); /health reports gateway liveness
# only; per-service health appears at /auth/health, /api/health and
# /audit/health once the services set PUBLIC_PREFIX (PR #996). Railway
# healthchecks for the gateway can point at /health.

    # Exported by the stock 15-local-resolvers.envsh (active when the
    # service sets NGINX_ENTRYPOINT_LOCAL_RESOLVERS): nameservers from
    # /etc/resolv.conf, IPv6 addresses bracketed — required form for the
    # resolver directive (Railway's DNS is an IPv6 literal, e.g.
    # fd12::10, which a bare literal misparses as host:port).
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;

    # Access-log policy (environment-access-policy §3, issue #1130):
    # Railway runtime logs must not carry secrets, and the default
    # `combined` format logs the FULL request line including the query
    # string — exactly where OAuth authorization codes ride on the
    # provider callbacks (/auth/v1/<provider>/callback?code=…,
    # /finalize_login?code=…; bearer-equivalent while live) and where
    # any client app's ?email=… would land. Log the path only ($uri is
    # the normalized, argument-free path). The referer is dropped too:
    # a navigation away from a callback page carries the callback URL —
    # query string included — in Referer. Query-string debugging
    # belongs to the audit trail, not the shared gateway log.
    log_format campus_nosecrets
        '$remote_addr - $remote_user [$time_local] '
        '"$request_method $uri $server_protocol" '
        '$status $body_bytes_sent "$http_user_agent"';
    access_log /dev/stdout campus_nosecrets;

server {
    listen ${PORT};
    server_name _;

    # Railway terminates TLS at the edge; backends see plain HTTP but
    # must generate https:// absolute URLs (campus ProxyFix reads the
    # X-Forwarded-* headers).
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Host $host;

    # X-Request-Start arrives from Railway's edge: Unix milliseconds for
    # when the request was received. Do NOT stamp it here — proxy_set_header
    # would overwrite that earlier value. Pass-through is the default.
    # Consumers accept both this form and "t=<seconds.milliseconds>" (#1243).

    # Trace-ingestion batches and login form posts are small, but don't
    # let nginx's 1m default surprise anyone.
    client_max_body_size 10m;

    # Emit relative Location on redirects (/ -> /audit/): otherwise
    # nginx makes it absolute from the listen port and leaks :8080.
    absolute_redirect off;

    # Upstreams: Railway PRIVATE networking (*.railway.internal, IPv6).
    # To flip to the public hairpin instead (worked around split-horizon
    # DNS once — see deploy/gateway/README.md), set the three lines to:
    #   "https://campusauth-development.up.railway.app" (+ proxy_ssl_server_name on)
    #   "https://campusapi-development.up.railway.app"
    #   "https://campusaudit-development.up.railway.app"
    # Variables force per-request DNS resolution (valid=10s below), so
    # backend redeploys never leave the gateway with a stale address.
    # Upstream HOSTS come from per-environment service variables (AUTH_HOST,
    # API_HOST, AUDIT_HOST) — the service rename + private-domain
    # regularization (2026-11-19) decoupled names from aliases, so a
    # host literal here silently rots: campusaudit.railway.internal 502'd
    # every /audit/ route the day campus.audit's alias became
    # campus-audit.railway.internal.
    set $auth_upstream  "http://${AUTH_HOST}:${AUTH_PORT}";
    set $api_upstream   "http://${API_HOST}:${API_PORT}";
    set $audit_upstream "http://${AUDIT_HOST}:${AUDIT_PORT}";

    # Downstream consumer apps (#1274), same private-mesh form as the
    # core trio — NOT the public hairpin: Railway's edge 404s
    # Host-mismatched requests outright on some services (observed on
    # timetable/apphost/profile/classroom 2026-11-25), so hairpinning
    # with Host: $host is unreliable for them. Private names are
    # <service-name>.railway.internal (no -dev suffix; verified per
    # service via its rendered RAILWAY_PRIVATE_DOMAIN, 2026-11-25) and
    # live in per-environment service variables — same rule as the core
    # hosts above: no literals here, they rot. Unset vars fall back to
    # the Dockerfile's .invalid placeholders (502, config stays valid).
    set $timetable_upstream "http://${TIMETABLE_HOST}:${TIMETABLE_PORT}";
    set $apphost_upstream   "http://${APPHOST_HOST}:${APPHOST_PORT}";
    set $admin_upstream     "http://${ADMIN_HOST}:${ADMIN_PORT}";
    set $profile_upstream   "http://${PROFILE_HOST}:${PROFILE_PORT}";
    set $classroom_upstream "http://${CLASSROOM_HOST}:${CLASSROOM_PORT}";

    # SNI for the HTTPS upstreams (*.up.railway.app requires it).
    proxy_ssl_server_name on;

    # nginx set directives re-assign in order, so exactly ONE active set
    # of upstream lines may exist here. The private-upstream variant
    # lives in the flip-back comment above — do NOT add active copies
    # of it (duplicated lines silently override the hairpin; this exact
    # leftover caused the 2026-10-29 502 chase, #995).

    location /integrations/ { proxy_pass $auth_upstream; }
    location /auth/         { proxy_pass $auth_upstream; }
    location /api/          { proxy_pass $api_upstream; }
    location /audit/        { proxy_pass $audit_upstream; }

    # Downstream apps (#1274). The no-slash exact matches keep
    # /timetable, /apps, … from falling through to the gateway-owned /
    # (302 /audit/) — the apps' own canonical entries are the slashed
    # forms; 308 preserves the method, absolute_redirect off keeps the
    # Location relative to this host.
    location = /timetable   { return 308 /timetable/; }
    location /timetable/    { proxy_pass $timetable_upstream; }
    location = /apps        { return 308 /apps/; }
    location /apps/         { proxy_pass $apphost_upstream; }
    location = /admin       { return 308 /admin/; }
    location /admin/        { proxy_pass $admin_upstream; }
    location = /profile     { return 308 /profile/; }
    location /profile/      { proxy_pass $profile_upstream; }
    location = /classroom   { return 308 /classroom/; }
    location /classroom/    { proxy_pass $classroom_upstream; }

    # Static assets for the mounted consumer apps (#1295): these were
    # built root-first, so url_for('static') emits host-root
    # /static/... regardless of the namespace they are served under —
    # unrouted at the gateway (the unstyled /timetable page, 2026-11-26).
    # Rewrite the namespaced path back to the app's root-level static
    # route; longest-prefix matching keeps these ahead of the plain
    # namespace locations above. The login_prefix mount and every other
    # app URL are blueprint/app routes under the namespace and need no
    # rewrite.
    location /timetable/static/ {
        rewrite ^/timetable/static/(.*)$ /static/$1 break;
        proxy_pass $timetable_upstream;
    }
    location /apps/static/ {
        rewrite ^/apps/static/(.*)$ /static/$1 break;
        proxy_pass $apphost_upstream;
    }
    location /admin/static/ {
        rewrite ^/admin/static/(.*)$ /static/$1 break;
        proxy_pass $admin_upstream;
    }
    location /profile/static/ {
        rewrite ^/profile/static/(.*)$ /static/$1 break;
        proxy_pass $profile_upstream;
    }
    location /classroom/static/ {
        rewrite ^/classroom/static/(.*)$ /static/$1 break;
        proxy_pass $classroom_upstream;
    }

    # Gateway-owned root: /health reports gateway liveness only (the
    # Railway healthcheck candidate), and / serves the Campus landing
    # page (#1292) — a static, anonymous page from the image, so the
    # root space never depends on an app being awake, logged in, or
    # deployed (the old 302 /audit/ handed the front door to one app).
    location = /health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }
    location = / {
        root /usr/share/nginx/html;
        try_files /campus-landing.html =500;
    }
}
